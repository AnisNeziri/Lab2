# Substitute AIMS_DOMAIN, AIMS_ROOT and PHP_FPM_SOCKET before nginx -t.
# Root is the release's frontend/dist, never the repository or private storage.
map $uri $aims_safe_path {
    default $uri;
    ~^/api/order-api/v1/tracking/ /api/order-api/v1/tracking/[redacted];
}
log_format aims_safe '$remote_addr $request_method $aims_safe_path $status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name ${AIMS_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${AIMS_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${AIMS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AIMS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root ${AIMS_ROOT}/frontend/dist;
    index index.html;
    client_max_body_size 110m;
    server_tokens off;
    access_log /var/log/nginx/aims-access.log aims_safe;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    location ~ /\. { deny all; }
    location ~ \.php(?:/|$) { return 404; }
    location ^~ /storage/ { return 404; }
    location ^~ /documents/ { return 404; }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location = /api { return 308 /api/; }
    location ^~ /api/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME ${AIMS_ROOT}/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT ${AIMS_ROOT}/backend/public;
        fastcgi_pass unix:${PHP_FPM_SOCKET};
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
    }
    location = /up {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME ${AIMS_ROOT}/backend/public/index.php;
        fastcgi_pass unix:${PHP_FPM_SOCKET};
    }
    location = /index.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location / { try_files $uri $uri/ /index.html; }
}
