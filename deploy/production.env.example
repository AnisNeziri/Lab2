APP_NAME=AIMS
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-company-domain
FRONTEND_URL=https://your-company-domain
APP_TIMEZONE=UTC
AIMS_COMPANY_TIMEZONE=Europe/Budapest
APP_LOCALE=en
APP_OPERATION_MODE=online
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aims_company
DB_USERNAME=aims_service
DB_PASSWORD=
DB_URL=
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
REDIS_ENABLED=true
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
AIMS_ML_PYTHON=/srv/aims/venv/bin/python
AIMS_DOCUMENT_ROOT=/srv/aims/shared/documents-private
AIMS_BACKUP_ROOT=/srv/aims/shared/encrypted-backups
AIMS_BACKUP_PASSPHRASE_FILE=/etc/aims/backup-passphrase
AIMS_BACKUP_SCHEDULE=daily
AIMS_BACKUP_KEEP=14
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
AIMS_MAIL_ENABLED=false
MAIL_MAILER=array
BROADCAST_CONNECTION=log
TRACKING_EXTERNAL_ENABLED=false
CORS_ALLOWED_ORIGINS=https://your-company-domain

# DC8: exact browser origin/RP; stable across updates. Keep issuer public keys outside releases.
AIMS_PASSKEY_RP_ID=aims.your-company.com
AIMS_PASSKEY_ORIGINS=https://aims.your-company.com
AIMS_LICENSE_PUBLIC_KEY_FILE=/srv/aims/shared/keys/license-public.pem
AIMS_UPDATE_PUBLIC_KEY_FILE=/srv/aims/shared/keys/update-public.pem
# Hash of a separately escrowed random recovery key (32+ characters); never the key itself.
AIMS_IDENTITY_RECOVERY_KEY_HASH=
