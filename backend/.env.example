APP_NAME="Inventory System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_OPERATION_MODE=online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use log locally so API works without Reverb. Set to reverb and run scripts/start-reverb.ps1 for live updates.
BROADCAST_CONNECTION=log

REVERB_APP_ID=aims-app
REVERB_APP_KEY=aims-key
REVERB_APP_SECRET=aims-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_TIMEOUT=0.5
REDIS_READ_TIMEOUT=0.5

# AIMS email (verification + password reset)
# Local testing: install Mailpit (https://github.com/axllent/mailpit) and open http://127.0.0.1:8025
# Production example (Gmail): MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_USERNAME=... MAIL_PASSWORD=app-password
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@aims-inventory.local"
MAIL_FROM_NAME="AIMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

FRONTEND_URL=http://localhost:5173
AUTH_VERIFICATION_EXPIRE_HOURS=24

TRACKING_VESSEL_PROVIDER=aisstream
TRACKING_EXTERNAL_ENABLED=true
TRACKING_SHIPMENT_PROVIDER=disabled
TRACKING_AIR_CARGO_PROVIDER=disabled
TRACKING_ALERT_DISTANCE_KM=50
TRACKING_VESSEL_CACHE_TTL=20
TRACKING_SHIPMENT_REFRESH_MINUTES=10
# Keep provider credentials server-side only. Parcel and air tracking stay
# disabled until a real provider adapter and credentials are configured.
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
TRACKING_VESSEL_LOOKUP_PROVIDER=vesselapi
VESSELAPI_API_KEY=
VESSELAPI_BASE_URL=https://api.vesselapi.com
VESSELAPI_CACHE_MINUTES=10
