{
  "name": "aims-desktop",
  "version": "1.1.0",
  "description": "AIMS offline desktop inventory system",
  "author": "AIMS",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.cjs",
    "start": "npm run prepare-assets && electron .",
    "dist:win": "npm run prepare-assets && electron-builder --win nsis --publish never",
    "dist:win:signed": "node scripts/verify-signing-env.cjs && npm run prepare-assets && electron-builder --win nsis --publish never",
    "release:win": "node scripts/verify-signing-env.cjs && npm run prepare-assets && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "41.10.5",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.aims.inventory",
    "productName": "AIMS",
    "copyright": "AIMS Inventory Management",
    "asar": true,
    "asarUnpack": [],
    "removePackageScripts": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/php",
        "to": "php"
      },
      {
        "from": "build/license-public.pem",
        "to": "license-public.pem"
      },
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      }
    ],
    "artifactName": "AIMS-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "AnisNeziri",
        "repo": "Lab2",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIMS",
      "deleteAppDataOnUninstall": false
    }
  }
}
